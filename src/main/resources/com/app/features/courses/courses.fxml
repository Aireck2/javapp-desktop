<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<fx:root
    type="VBox"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="16.0"
    styleClass="app-screen"
>
    <VBox spacing="2.0">
        <Label text="Mis Cursos" styleClass="screen-title" />
        <Label
            text="Próximas sesiones programadas (Hoy … +5 días)"
            styleClass="screen-subtitle"
        />
    </VBox>
    <StackPane fx:id="stateContainer" styleClass="course-state-container" />
</fx:root>
