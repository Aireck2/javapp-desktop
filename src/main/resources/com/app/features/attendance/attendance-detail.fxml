<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<fx:root
    type="VBox"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="14.0"
    styleClass="app-screen"
>
    <VBox spacing="8.0" styleClass="attendance-session-header">
        <Button
            text="← Mis cursos"
            onAction="#goBack"
            styleClass="secondary-button"
        />
        <Label fx:id="courseCode" styleClass="attendance-overline" />
        <Label fx:id="courseName" styleClass="screen-title" wrapText="true" />
        <Label
            fx:id="sessionDetails"
            styleClass="attendance-session-details"
            wrapText="true"
        />
        <Label fx:id="sessionState" styleClass="screen-subtitle" />
    </VBox>

    <VBox spacing="8.0">
        <Label
            text="NÓMINA Y ASISTENCIA"
            styleClass="attendance-section-label"
        />
        <HBox spacing="8.0" styleClass="attendance-summary">
            <VBox
                alignment="CENTER"
                spacing="2.0"
                styleClass="attendance-stat attendance-stat-total"
                HBox.hgrow="ALWAYS"
            >
                <Label
                    fx:id="totalValue"
                    text="0"
                    styleClass="attendance-stat-value"
                />
                <Label text="Total" styleClass="attendance-stat-label" />
            </VBox>
            <VBox
                alignment="CENTER"
                spacing="2.0"
                styleClass="attendance-stat attendance-stat-present"
                HBox.hgrow="ALWAYS"
            >
                <Label
                    fx:id="presentValue"
                    text="0"
                    styleClass="attendance-stat-value"
                />
                <Label text="Presentes" styleClass="attendance-stat-label" />
            </VBox>
            <VBox
                alignment="CENTER"
                spacing="2.0"
                styleClass="attendance-stat attendance-stat-absent"
                HBox.hgrow="ALWAYS"
            >
                <Label
                    fx:id="absentValue"
                    text="0"
                    styleClass="attendance-stat-value"
                />
                <Label text="Faltas" styleClass="attendance-stat-label" />
            </VBox>
            <VBox
                alignment="CENTER"
                spacing="2.0"
                styleClass="attendance-stat attendance-stat-exempt"
                HBox.hgrow="ALWAYS"
            >
                <Label
                    fx:id="exemptValue"
                    text="0"
                    styleClass="attendance-stat-value"
                />
                <Label text="Exentos" styleClass="attendance-stat-label" />
            </VBox>
        </HBox>
    </VBox>

    <TextField
        fx:id="searchField"
        promptText="Buscar por nombre o código de alumno..."
        styleClass="attendance-search"
    />
    <HBox spacing="6.0">
        <Button fx:id="filterAllButton" text="Todos" onAction="#filterAll" />
        <Button
            fx:id="filterPresentButton"
            text="Presentes"
            onAction="#filterPresent"
        />
        <Button
            fx:id="filterAbsentButton"
            text="Faltas"
            onAction="#filterAbsent"
        />
        <Button
            fx:id="filterExemptButton"
            text="Exentos"
            onAction="#filterExempt"
        />
    </HBox>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Acción masiva" styleClass="attendance-overline" />
        <Button
            fx:id="allPresentButton"
            text="Marcar todos presentes"
            onAction="#markAllPresent"
            styleClass="bulk-present-button"
        />
        <Button
            fx:id="allAbsentButton"
            text="Marcar todos ausentes"
            onAction="#markAllAbsent"
            styleClass="bulk-absent-button"
        />
    </HBox>
    <VBox fx:id="studentList" spacing="10.0" />
    <Accordion>
        <panes>
            <TitledPane
                text="Observaciones generales de la sesión"
                expanded="false"
            >
                <content>
                    <TextArea
                        fx:id="observation"
                        promptText="Observaciones de esta sesión"
                        prefRowCount="3"
                    />
                </content>
            </TitledPane>
        </panes>
    </Accordion>
    <VBox spacing="8.0">
        <HBox spacing="10.0">
            <Button
                fx:id="saveDraftButton"
                text="Guardar borrador"
                onAction="#saveDraft"
                HBox.hgrow="ALWAYS"
            />
            <Button
                fx:id="submitButton"
                text="Registrar sesión"
                onAction="#submitAttendance"
                styleClass="primary-button"
                HBox.hgrow="ALWAYS"
            />
        </HBox>
        <Label fx:id="status" wrapText="true" styleClass="attendance-status" />
    </VBox>
</fx:root>
