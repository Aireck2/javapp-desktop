<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<fx:root
    type="VBox"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="16.0"
    styleClass="app-screen"
>
    <VBox spacing="4.0">
        <Label text="Mis Cursos" styleClass="screen-title" />
        <Label
            text="Monitorea tu margen reglamentario de inasistencias y estado de cursos."
            styleClass="screen-subtitle"
            wrapText="true"
        />
    </VBox>
    <HBox
        spacing="10.0"
        alignment="CENTER_LEFT"
        styleClass="student-course-info-banner"
    >
        <Label text="ⓘ" styleClass="student-course-info-icon" />
        <Label
            text="Límite reglamentario (DPI): máximo 30% de inasistencias permitidas en el ciclo."
            styleClass="student-course-info-text"
            wrapText="true"
            HBox.hgrow="ALWAYS"
        />
    </HBox>
    <StackPane fx:id="stateContainer" styleClass="dashboard-state-container" />
</fx:root>
