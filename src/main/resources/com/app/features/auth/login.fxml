<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<fx:root
    type="VBox"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    alignment="CENTER"
    spacing="14.0"
    styleClass="app-screen"
>
    <VBox
        alignment="CENTER"
        spacing="14.0"
        maxWidth="350.0"
        minWidth="300.0"
        prefWidth="350.0"
    >
        <ImageView
            fx:id="logo"
            fitWidth="84.0"
            fitHeight="84.0"
            preserveRatio="true"
        />
        <VBox alignment="CENTER" spacing="8.0">
            <HBox
                alignment="CENTER"
                spacing="6.0"
                styleClass="login-period-badge"
            >
                <Circle radius="3.0" styleClass="login-period-dot" />
                <Label
                    text="Período Lectivo 2024-II • Acceso Institucional"
                    styleClass="login-period-text"
                />
            </HBox>
            <Label text="Portal Académico" styleClass="login-title" />
            <Label
                text="Plataforma de Gestión y Control de Asistencia Universitaria"
                wrapText="true"
                textAlignment="CENTER"
                styleClass="screen-subtitle"
            />
        </VBox>
        <VBox spacing="14.0" styleClass="login-form-card">
            <VBox spacing="6.0">
                <Label
                    text="Usuario o Correo Institucional"
                    styleClass="login-field-label"
                />
                <TextField
                    fx:id="usernameField"
                    promptText="ej. d.alvarez@universidad.edu.pe"
                    styleClass="login-field"
                />
            </VBox>
            <VBox spacing="6.0">
                <Label text="Contraseña" styleClass="login-field-label" />
                <PasswordField
                    fx:id="passwordField"
                    promptText="••••••••••••"
                    styleClass="login-field"
                />
            </VBox>
            <CheckBox
                fx:id="rememberMe"
                text="Mantener sesión iniciada"
                selected="true"
                styleClass="login-remember"
            />
            <Label
                fx:id="errorLabel"
                wrapText="true"
                styleClass="login-error"
            />
            <Button
                fx:id="loginButton"
                text="➔ Iniciar Sesión"
                maxWidth="Infinity"
                styleClass="login-submit"
            />
        </VBox>
        <Label
            text="Demo: admin/demo · docente/demo · alumno/demo"
            styleClass="login-demo-hint"
        />
        <Region VBox.vgrow="ALWAYS" />
        <Label
            text="Dirección General de Tecnologías Académicas © 2024"
            styleClass="login-footer"
        />
    </VBox>
</fx:root>
